# ============================================================
#  dev3d - orchestrator configuration
#  Copy to .env and fill in the providers you actually have.
#  With no keys at all the office still runs end to end: employees
#  are scripted instead of billed, and the UI badges the mode.
# ============================================================

# --- server bind ---
HOST=127.0.0.1
PORT=8787

# --- web UI (development only) ---
# The Vite dev server proxies /api and /ws to the orchestrator. It reads these
# from the environment or from apps/web/.env.local, so a server started on a
# different port does not need the proxy edited by hand.
# DEV3D_SERVER_HOST=127.0.0.1
# DEV3D_SERVER_PORT=8787

# Force the browser's websocket URL instead of deriving it from the page origin.
# Only needed when the UI is served from somewhere other than the orchestrator.
# VITE_WS_URL=ws://127.0.0.1:8787/ws

# --- engine behaviour ---
# auto (default) -> live when any provider key is present, otherwise mock.
# Force 'mock' to run the whole office on scripted employees with no billing,
# or 'live' to require real providers.
#
# Note what 'auto' means the moment you add a key below: the office starts
# spending real money on real models. Set this to 'mock' to look around first.
DEV3D_LLM_MODE=auto

# debug | info | warn | error
DEV3D_LOG_LEVEL=info

# Where the skill markdown documents live.
DEV3D_SKILLS_DIR=./skills

# Let employees run shell commands without asking a human first.
# Leave this false unless you are running unattended: a shell is the most
# dangerous tool in the system, and approval is the only thing gating it.
DEV3D_AUTO_APPROVE_SHELL=false

# How long an approval waits for a human before it is treated as refused (ms).
DEV3D_APPROVAL_TIMEOUT_MS=600000

# How many days of the event log to keep. Pruned once per boot; 0 keeps
# everything. Runs, turns and artifacts are never pruned.
DEV3D_EVENT_RETENTION_DAYS=30

# Let a plugin panel be served from a private address (loopback, 10.x, 169.254.x).
# Off by default: the *server* fetches a panel source and the answer is drawn on
# the operator's screen, so a panel pointing at loopback is a probe with a display.
# Turn it on only while developing a plugin against a local dev server.
DEV3D_ALLOW_PRIVATE_PANEL_HOSTS=false

# Ask the operator before a run's spend crosses this soft threshold, in USD.
# Set to 0 to disable the soft-spend gate.
DEV3D_SOFT_SPEND_APPROVAL_USD=1.50

# --- providers (any subset; OpenAI-compatible unless noted) ---
# DeepSeek, OpenAI, OpenRouter, Groq, Together, vLLM/Ollama all speak
# the OpenAI chat-completions shape and share one adapter.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Override base URLs for self-hosted gateways / proxies.
DEV3D_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEV3D_OPENAI_BASE_URL=https://api.openai.com/v1
DEV3D_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEV3D_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Any OpenAI-compatible local runtime, e.g. Ollama (http://127.0.0.1:11434/v1)
DEV3D_LOCAL_BASE_URL=
DEV3D_LOCAL_API_KEY=

# OpenRouter attributes requests on its leaderboards from these two headers.
# Point them at your own deployment if you run a fork.
DEV3D_OPENROUTER_REFERER=https://github.com/scarecr0w12/dev3d
DEV3D_OPENROUTER_TITLE=dev3d office

# --- employee sandbox ---
# The default workspace: the directory a run uses when it names no project.
# Every file/shell tool an employee uses is confined to the workspace of the run
# it is serving.
DEV3D_WORKSPACE=./workspace

# --- projects (workspaces) ---
# Where the Projects tab creates new project folders.
DEV3D_WORKSPACES_ROOT=./workspaces

# Whether a project may point at an absolute path outside DEV3D_WORKSPACES_ROOT.
# On by default, because the point of the office is working on real projects that
# already exist elsewhere - and the operator typing that path is the consent.
# A workspace's directory becomes fully readable and writable to employees, so
# set this to false to make the workspaces root a hard boundary.
DEV3D_ALLOW_EXTERNAL_WORKSPACES=true

# --- blender (developer tooling only) ---
# Not read by the orchestrator. `pnpm preview:blocks` and the other Blender
# scripts resolve the binary in this order, so on a machine where Blender is
# neither on PATH nor in a default install location, name it here:
#
#   1. DEV3D_BLENDER      full path to the executable
#   2. DEV3D_BLENDER_DIR  the directory holding it
#   3. `blender` on PATH
#   4. default install locations, newest release first
#
# Both accept forward or backslashes; leave them empty to fall through to PATH.
# DEV3D_BLENDER=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# DEV3D_BLENDER_DIR=C:\Program Files\Blender Foundation\Blender 4.2

# --- plugins ---
# Where plugins ship from and where they are loaded from. Every subdirectory
# holding a plugin.json is one plugin; the shipped examples in ./plugins are a
# declarative one (models, a skill, routing rules) and a code one (a tool).
DEV3D_PLUGINS_DIR=./plugins

# Installed plugins land here, away from the shipped set, so a download can
# never be confused with something that came with the checkout.
DEV3D_PLUGIN_INSTALL_DIR=./data/plugins

# Whether the office may download and install a plugin bundle from a marketplace
# URL at all. Off by default: installing runs someone else's code inside the
# orchestrator's own process, so turning it on is a deliberate decision.
# Set to true to enable the Marketplace tab's Install button.
DEV3D_ALLOW_PLUGIN_INSTALL=false

# --- persistence ---
DEV3D_DB=./data/dev3d.sqlite

# --- routing posture ---
# cheap  -> always pick the lowest-cost model that satisfies the task class
# balanced (default) -> escalate to a stronger model when a task is hard
# quality -> prefer the strongest model everywhere
#
# Posture is one input among several. The router ranks candidates on their
# quality, their fitness for the turn's task class, how close their tier is to
# the one the policy chose, and their price - so a model that is genuinely better
# at coding can win over a cheaper one of the same size.
DEV3D_ROUTING=balanced

# --- model discovery ---
# Ask each provider what models it actually serves, from its own /models
# endpoint. On by default, because a static list is wrong the moment a vendor
# ships or retires a model: this checkout shipped a DeepSeek model that the
# DeepSeek endpoint does not serve.
#
# Membership comes from the provider; tier, price and quality come from the
# curated table in apps/server/src/llm/catalog.ts. A model the provider no longer
# serves is withdrawn from routing rather than left to fail a turn, and a model
# nobody has described is still routable, flagged as unrated.
#
# Set to false to keep the office entirely offline: the curated table then stands
# alone, exactly as the old hardcoded catalog did. `mock` mode never discovers,
# so the keyless office keeps its full demonstrable catalog either way.
DEV3D_MODEL_DISCOVERY=true

# How long a discovered list stays fresh before being asked for again (ms).
DEV3D_MODEL_DISCOVERY_TTL_MS=21600000

# Where discovered lists are cached between restarts. `off` disables the cache,
# at the cost of a network round trip per provider on every boot.
DEV3D_MODEL_DISCOVERY_CACHE=./data/model-discovery.json

# --- pooled model quality (optional) ---
# Two quality sources need no configuration and never leave the machine:
#   curated  the table in apps/server/src/llm/catalog.ts, always present
#   learned  what this office observed from its own finished turns
# This is the third, and it is the only one that makes an outbound call.
#
# Artificial Analysis publishes independent intelligence, coding and math
# indices. Its free API needs a key and requires attribution, which is carried on
# every score it produces and shown in the console. No key means no request is
# made at all.
#
# Note that OpenRouter's public model list needs no key, but it carries prices
# and capabilities rather than benchmarks, so it feeds discovery rather than
# this. OpenRouter's benchmark endpoint requires browser-session auth and is not
# usable from a server.
#
# The key is read from the variable NAMED here. Only the name is ever stored, so
# a secret never reaches a settings document, a log line or the browser.
DEV3D_POOLED_QUALITY_KEY_VAR=ARTIFICIAL_ANALYSIS_API_KEY
ARTIFICIAL_ANALYSIS_API_KEY=

# A benchmark index moves on the scale of weeks, and the free API is rate-limited
# to 1,000 requests a day, so the default is a week.
DEV3D_POOLED_QUALITY_TTL_MS=604800000
DEV3D_POOLED_QUALITY_CACHE=./data/pooled-quality.json

# --- OpenRouter benchmarks (preferred pooled source) ---
# OpenRouter's /api/v1/benchmarks aggregates three sources behind one bearer key:
#   artificial-analysis  intelligence, coding and agentic indices
#   design-arena         Elo, win rate and timing per arena and category
#   openrouter           its own benchmark runs (gpqa_diamond and similar)
# Because it includes the Artificial Analysis indices, enabling this makes the
# direct DEV3D_POOLED_QUALITY_KEY_VAR above redundant - one key covers more
# ground than two. Requires OPENROUTER_API_KEY.
#
# Scores are ranked as a PERCENTILE of the benchmarked population, not mapped
# through a fixed window. Measured against the live payload the median
# intelligence index is 22.3 with a maximum of 53.4, so the published example
# scale (values around 60-90) would place the median model at 0.11 and never
# award a top score to anything. A percentile is self-calibrating and honest
# about being a standing among measured models rather than absolute capability.
#
# Coverage is genuinely partial and the console reports the real numbers:
# measured, 118 of OpenRouter's 445 models match a benchmark row. The payload
# uses dated snapshots that often do not match a current model id, so most models
# a router can pick carry no pooled opinion - which is why the learned layer,
# built from this office's own turns, is usually the one that matters.
DEV3D_BENCHMARKS=true
DEV3D_BENCHMARK_TTL_MS=86400000
DEV3D_BENCHMARK_CACHE=./data/benchmarks.json

# --- upstream endpoint uptime (no key required) ---
# GET /api/v1/models/{author}/{slug}/endpoints is public and lists every upstream
# OpenRouter would route a model to. Measured field coverage across 34 endpoints:
#
#   uptime_last_30m      79% populated   <- this is the signal
#   latency_last_30m      0% populated
#   throughput_last_30m   0% populated
#
# So this tracks uptime and nothing else. Latency and throughput are documented
# fields that are simply empty in the live payload, and a speed-aware router
# built on them would have been built on zeros.
#
# A model at 0% uptime loses 0.30 of score - a demotion, never an exclusion,
# because uptime is a rolling figure that can be stale and hard-excluding on a
# stale reading would remove a good option with no way back. An unknown model
# contributes exactly nothing, so nothing is penalised for being unmeasured.
#
# Lookups are on demand and never block a turn: the router asks as it considers a
# model, and a model nobody routes to is never fetched.
DEV3D_ENDPOINT_HEALTH=true
# Only these providers' models are OpenRouter slugs underneath. A direct DeepSeek
# or Anthropic key does not route through OpenRouter, so its endpoint health says
# nothing about the call this office will make.
DEV3D_ENDPOINT_HEALTH_PROVIDERS=openrouter
DEV3D_ENDPOINT_HEALTH_TTL_MS=600000
DEV3D_ENDPOINT_HEALTH_CACHE=./data/endpoint-health.json

# Hard ceiling per run, in USD. The engine halts a run that would exceed it.
DEV3D_RUN_BUDGET_USD=5.00

# --- MCP servers ---
# Model Context Protocol servers. dev3d is an MCP *client*: it connects to
# servers you point it at and publishes their tools to employees as
# mcp__<server-id>__<tool-name>. Nothing is connected until you configure one.
#
# Off only if you want to be sure no MCP connection is ever attempted.
DEV3D_MCP=true

# Where servers are configured. The JSON file is the richer source and wins on a
# conflicting id:
#
#   { "servers": [
#       { "id": "fs", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "."] },
#       { "id": "remote", "type": "http", "url": "https://mcp.example.com/mcp" }
#   ] }
#
# See mcp.json.example. An absent file simply means no servers from this source.
# Set it to an empty value to disable the file and use DEV3D_MCP_SERVERS alone.
DEV3D_MCP_CONFIG=./mcp.json

# Or name servers inline: `<id>=<command> [args...]`, separated by ";". A
# semicolon rather than a space, because arguments routinely contain spaces.
# The JSON file above is the better choice for anything with several servers.
#   DEV3D_MCP_SERVERS="fs=npx -y @modelcontextprotocol/server-filesystem /srv; git=uvx mcp-server-git"
DEV3D_MCP_SERVERS=

# Which roles may call MCP tools: a comma-separated list of role ids, "*" for
# every role, or "none" for nobody.
#
# The default is "none", and that is deliberate. An MCP server's tools are run by
# somebody else's process, are not confined to the run's workspace, and dev3d never
# sees the arguments again — so a role holding run_shell is *not* a reason to hand
# it a filesystem or a deployment system. Name the roles that should have them.
#
# "shell-roles" restores the old behaviour (every role holding run_shell, which is
# the marker for "the employees who can already run commands"); "run_shell" is
# accepted as a synonym.
DEV3D_MCP_GRANT_ROLES=none

# Whether the first call to a tool from a newly connected MCP server asks a human.
# On by default: it is the only gate an MCP tool has. Asked once per server per
# connection — a prompt on every call would be answered by reflex. Either answer is
# remembered until the server reconnects, at which point it is a new process on the
# other end and worth asking about again.
DEV3D_MCP_REQUIRE_APPROVAL=true

# ---------------------------------------------------------------- vendors ---

# Third-party agent harnesses. Where MCP gives dev3d other *tools*, a vendor is
# another *agent*: Codex, DeepSeek Harness, Hermes, or anything you can name a
# command for. An employee hands it a self-contained task and gets a written
# answer back, and each vendor is docked in the 3D office as a rented terminal.
#
# Delegations are READ-ONLY in this release, and that word covers three different
# guarantees. The Vendors page shows which one each vendor has:
#
#   SANDBOXED   the harness confines itself, with an OS sandbox dev3d asked for.
#               Holds for everything the process does.        e.g. codex
#   MEDIATED    dev3d drives it over the Agent Client Protocol and answers for
#               it: writes refused, reads confined to the run's workspace, every
#               tool call put to a human first.               e.g. openclaw
#   REQUESTED   the task text asks and nothing enforces it, so the delegation is
#               held for human approval before it starts.     e.g. dsh, hermes
#
# A guarantee and a request are not the same thing, and the office will not render
# them as one badge. Nothing is launched until you configure a vendor.
#
# Off only if you want to be certain the office never starts a program it did not
# ship.
DEV3D_VENDOR_DELEGATION=true

# Inline vendors, separated by ";". An entry is a preset name, or <id>=<preset>
# to give the same harness two identities.
#
#   DEV3D_VENDORS="codex;dsh;hermes;openclaw"
#   DEV3D_VENDORS="fast=codex;cheap=dsh"
#
# Presets: codex, dsh, hermes, openclaw. For anything else - a different binary, extra
# arguments, a per-vendor timeout - use the file below.
DEV3D_VENDORS=

# The vendor file. See vendors.json.example. An absent file simply means no
# vendors from this source. Set it to an empty value to disable the file and use
# DEV3D_VENDORS alone.
DEV3D_VENDORS_CONFIG=./vendors.json

# Which roles may hand work to a vendor. The default, "delegate-roles", means
# "the employees already marked canDelegate on the org chart" - a marker rather
# than a list of role ids because role ids belong to a chart you can rename, and
# a list written here would quietly stop matching.
#
#   delegate-roles   whoever Role.canDelegate already says may delegate
#   *                everyone (still subject to the flag below)
#   none             nobody
#   cto,dev-lead     exactly those role ids
DEV3D_VENDOR_GRANT_ROLES=delegate-roles

# Whether Role.canDelegate is ALSO required, in addition to the grant above.
# The two are independent gates and both must open. Setting this to false while
# DEV3D_VENDOR_GRANT_ROLES is "*" opens the door to every employee - which is why
# it defaults to true.
DEV3D_VENDOR_REQUIRE_CAN_DELEGATE=true

# --- daily driver limits ---
# Max concurrently executing employees (sub-agents) inside one company.
DEV3D_MAX_CONCURRENCY=4

# ---------------------------------------------------------------- memory ----

# Whether memory recall may use vector search alongside full text.
#
# Off by default, and off is a COMPLETE configuration: lexical recall is the
# whole memory system and this only adds a re-ranking on top. It is off because
# FTS5 measured about three orders of magnitude faster and six times smaller than
# a brute-force vector scan on this corpus, and because the queries this workload
# produces - file paths, identifiers, error strings - are exactly where BM25 is
# strongest. Measure the lexical ceiling on your own queries before paying for
# this.
#
# Switching it on also REQUIRES an embedding endpoint (see below). With none
# configured this flag does nothing, and the office says so rather than
# pretending otherwise.
DEV3D_MEMORY_VECTORS=false

# The embedding endpoint to use, as `provider/model`, or empty for none.
#
# DeepSeek and Anthropic serve no embeddings at all; OpenAI, OpenRouter and a
# local runtime may. A bare model name is not accepted, because the same name on
# two vendors is two different vector spaces and blending them would make every
# distance a lie.
#
#   DEV3D_MEMORY_EMBEDDING=openai/text-embedding-3-small
#   DEV3D_MEMORY_EMBEDDING=openrouter/nvidia/llama-nemotron-embed-vl-1b-v2:free
#   DEV3D_MEMORY_EMBEDDING=local/nomic-embed-text
#
# The index is 768 dimensions wide. A model of a different width is refused at
# write time rather than truncated, because a 384-dimension vector packed into
# 768 columns produces distances that are numbers and mean nothing.
DEV3D_MEMORY_EMBEDDING=
