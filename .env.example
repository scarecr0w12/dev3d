# ============================================================
#  dev3d - orchestrator configuration
#  Copy to .env and fill in the providers you actually have.
#  With no keys at all the office still runs end to end: employees
#  are scripted instead of billed, and the UI badges the mode.
# ============================================================

# --- server bind ---
HOST=127.0.0.1
PORT=8787

# --- web UI (development only) ---
# The Vite dev server proxies /api and /ws to the orchestrator. It reads these
# from the environment or from apps/web/.env.local, so a server started on a
# different port does not need the proxy edited by hand.
# DEV3D_SERVER_HOST=127.0.0.1
# DEV3D_SERVER_PORT=8787

# Force the browser's websocket URL instead of deriving it from the page origin.
# Only needed when the UI is served from somewhere other than the orchestrator.
# VITE_WS_URL=ws://127.0.0.1:8787/ws

# --- engine behaviour ---
# auto (default) -> live when any provider key is present, otherwise mock.
# Force 'mock' to run the whole office on scripted employees with no billing,
# or 'live' to require real providers.
#
# Note what 'auto' means the moment you add a key below: the office starts
# spending real money on real models. Set this to 'mock' to look around first.
DEV3D_LLM_MODE=auto

# debug | info | warn | error
DEV3D_LOG_LEVEL=info

# Where the skill markdown documents live.
DEV3D_SKILLS_DIR=./skills

# Let employees run shell commands without asking a human first.
# Leave this false unless you are running unattended: a shell is the most
# dangerous tool in the system, and approval is the only thing gating it.
DEV3D_AUTO_APPROVE_SHELL=false

# How long an approval waits for a human before it is treated as refused (ms).
DEV3D_APPROVAL_TIMEOUT_MS=600000

# Ask the operator before a run's spend crosses this soft threshold, in USD.
# Set to 0 to disable the soft-spend gate.
DEV3D_SOFT_SPEND_APPROVAL_USD=1.50

# --- providers (any subset; OpenAI-compatible unless noted) ---
# DeepSeek, OpenAI, OpenRouter, Groq, Together, vLLM/Ollama all speak
# the OpenAI chat-completions shape and share one adapter.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Override base URLs for self-hosted gateways / proxies.
DEV3D_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEV3D_OPENAI_BASE_URL=https://api.openai.com/v1
DEV3D_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEV3D_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Any OpenAI-compatible local runtime, e.g. Ollama (http://127.0.0.1:11434/v1)
DEV3D_LOCAL_BASE_URL=
DEV3D_LOCAL_API_KEY=

# --- employee sandbox ---
# The default workspace: the directory a run uses when it names no project.
# Every file/shell tool an employee uses is confined to the workspace of the run
# it is serving.
DEV3D_WORKSPACE=./workspace

# --- projects (workspaces) ---
# Where the Projects tab creates new project folders.
DEV3D_WORKSPACES_ROOT=./workspaces

# Whether a project may point at an absolute path outside DEV3D_WORKSPACES_ROOT.
# On by default, because the point of the office is working on real projects that
# already exist elsewhere - and the operator typing that path is the consent.
# A workspace's directory becomes fully readable and writable to employees, so
# set this to false to make the workspaces root a hard boundary.
DEV3D_ALLOW_EXTERNAL_WORKSPACES=true

# --- plugins ---
# Where plugins ship from and where they are loaded from. Every subdirectory
# holding a plugin.json is one plugin; the shipped examples in ./plugins are a
# declarative one (models, a skill, routing rules) and a code one (a tool).
DEV3D_PLUGINS_DIR=./plugins

# Installed plugins land here, away from the shipped set, so a download can
# never be confused with something that came with the checkout.
DEV3D_PLUGIN_INSTALL_DIR=./data/plugins

# Whether the office may download and install a plugin bundle from a marketplace
# URL at all. Off by default: installing runs someone else's code inside the
# orchestrator's own process, so turning it on is a deliberate decision.
# Set to true to enable the Marketplace tab's Install button.
DEV3D_ALLOW_PLUGIN_INSTALL=false

# --- persistence ---
DEV3D_DB=./data/dev3d.sqlite

# --- routing posture ---
# cheap  -> always pick the lowest-cost model that satisfies the task class
# balanced (default) -> escalate to a stronger model when a task is hard
# quality -> prefer the strongest model everywhere
DEV3D_ROUTING=balanced

# Hard ceiling per run, in USD. The engine halts a run that would exceed it.
DEV3D_RUN_BUDGET_USD=5.00

# --- daily driver limits ---
# Max concurrently executing employees (sub-agents) inside one company.
DEV3D_MAX_CONCURRENCY=4
