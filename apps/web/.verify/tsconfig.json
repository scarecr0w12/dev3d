{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["./smoke.ts", "../src/app/store.ts", "../src/app/format.ts", "../src/office/floors.ts"]
}
